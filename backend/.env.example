# Copie este arquivo para backend/.env. Nunca publique tokens reais no Git.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Para certificado de uma CA privada, informe o caminho. Vazio usa CAs do sistema.
MQTT_CA_CERT=
MQTT_CLIENT_ID=arcadeos-backend
# Vazio usa arcadeos/DEVICE_ID/telemetry. Não use curingas + ou # para telemetria.
MQTT_TOPIC=

INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=substitua-pelo-token-do-influxdb
INFLUX_ORG=arcadeos
INFLUX_BUCKET=telemetry

DEVICE_ID=arcade-01
DEVICE_NAME=Player One
DEVICE_LOCATION=Gabinete principal
WARNING_TEMPERATURE=35
CRITICAL_TEMPERATURE=40
STALE_AFTER_SECONDS=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
